# ─────────────────────────────────────────────────────────────
# EzTix Environment Configuration Example
# Copy to .env (or apps/api/.env and apps/web/.env.local)
# Never commit real credentials or secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── Server & Origins ────────────────────────────────────────
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ─── PostgreSQL (Local Docker or Neon in production) ─────────
# Pooled connection string used by the runtime Prisma driver adapter (@prisma/adapter-pg)
DATABASE_URL="postgresql://eztix:eztix_dev_password@localhost:5432/eztix?schema=public"
# Direct connection string used by Prisma CLI / migrations (prisma.config.ts)
DIRECT_URL="postgresql://eztix:eztix_dev_password@localhost:5432/eztix?schema=public"

# ─── Redis (Local Docker or Upstash in production) ───────────
REDIS_URL="redis://localhost:6379"

# ─── Authentication & Token Secrets (min 32 chars in prod) ───
JWT_ACCESS_SECRET="replace-with-at-least-32-char-random-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-32-char-random-refresh-secret"
JWT_SOCKET_SECRET="replace-with-at-least-32-char-random-socket-secret"
PASS_SECRET="replace-with-at-least-32-char-random-purchase-pass-secret"
WEBHOOK_SECRET="replace-with-at-least-32-char-random-webhook-hmac-secret"
TICKET_QR_SECRET="replace-with-at-least-32-char-random-ticket-qr-secret"

# ─── Cloudflare Turnstile (Bot Protection) ───────────────────
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─── Email (Mailpit locally, Resend in production) ───────────
SMTP_HOST="localhost"
SMTP_PORT=1025
EMAIL_FROM="no-reply@eztix.local"
RESEND_API_KEY=""

# ─── Cloudinary (Poster Image Uploads) ───────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Observability (Sentry) ──────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Seed Script Credentials (Used by prisma db seed) ────────
SEED_ADMIN_EMAIL="admin@eztix.my"
SEED_ADMIN_PASSWORD="ChangeMeAdmin123!"
